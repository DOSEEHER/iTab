{
  "manifest_version": 3,
  "name": "iTab",
  "short_name": "iTab",
  "version": "1.0.0",
  "description": "打开 Chrome 新标签页时自动跳转至 iTab (https://itab.xike.io)。",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
